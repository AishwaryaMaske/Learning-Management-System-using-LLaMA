# LMS Server Configuration
PORT=3000

# Local LLaMA via Ollama Runtime
OLLAMA_ENDPOINT="http://localhost:11434"
OLLAMA_MODEL="llama3:8b"

# Local Privacy Metasearch Engine
SEARXNG_ENDPOINT="http://localhost:8080"

# Database Connection (MongoDB)
MONGODB_URI="mongodb://localhost:27017/lms_llama_db"

# Optional YouTube Data API v3 Key (Leave empty to use curated educational curriculum)
YOUTUBE_API_KEY=""

# AI Studio App Hosting URL
APP_URL="MY_APP_URL"
